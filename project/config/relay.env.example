# api-relay 环境变量模板（示例）
#
# 复制为 .relay.env 后填入真实值；该文件权限务必设为 600，且**不要提交到版本库**。
#
# 由 systemd 通过 EnvironmentFile=/root/api-relay/.relay.env 注入。

# ── OpenCSG 上游密钥（三把，对应三个 provider）──
OPENCSG_API_KEY_1=
OPENCSG_API_KEY_2=
OPENCSG_API_KEY_3=

# ── 管理令牌（访问 /admin 面板用）──
RELAY_ADMIN_TOKEN=

# ── 客户端密钥（调用 /v1 网关用）──
RELAY_KEY_FREE=
RELAY_KEY_STANDARD=
RELAY_KEY_PRO=