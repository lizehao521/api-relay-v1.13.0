# 组合方案（api-relay 底座 + CodeLens 工作台）本地密钥模板
# 复制为 combo.env 后填入真实值，chmod 600，切勿提交。
#
#   cp combo.env.example combo.env && chmod 600 combo.env
#
# 本文件只被 start-combo.sh 读取，密钥不会写入任何构建产物。

# ── 上游：NVIDIA NIM（OpenAI 兼容）──
NVIDIA_API_KEY_1=
NVIDIA_API_KEY_2=

# ── 下游：CodeLens 调用底座用的 client key ──
# 建议生成：printf 'sk-relay-%s' "$(openssl rand -hex 20)"
RELAY_KEY_CODELENS=

# ── 底座管理令牌（访问 /admin 面板用）──
# 建议生成：openssl rand -hex 24
RELAY_ADMIN_TOKEN=

# ── 可选：指定 Node 22 可执行文件 ──
# NODE_BIN=/path/to/node